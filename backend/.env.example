# Copy this file to `.env` and adjust the values.

# --- Web server -----------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- MySQL connection -----------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_traffic_db
DB_POOL_SIZE=10
# Session time zone used for NOW()/CURDATE() and for Date <-> DATETIME conversion
DB_TIMEZONE=+05:30

# --- Auth -----------------------------------------------------------------
# Use a long random string in real deployments:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Optional ---------------------------------------------------------------
# Restrict CORS to specific origins (comma separated). Empty = allow all (dev).
CORS_ORIGIN=
